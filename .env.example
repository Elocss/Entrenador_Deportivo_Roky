# -----------------------------------------------------------------------------
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO PARA ROKY
# Copia este archivo como '.env' en esta misma carpeta o en 'backend/'
# y completa los valores correspondientes.
# -----------------------------------------------------------------------------

# Configuración del Servidor Backend (FastAPI)
HOST=0.0.0.0
PORT=8000

# Configuración de Google Cloud / Firebase Firestore
GOOGLE_CLOUD_PROJECT=roky-fitness-app
FIRESTORE_CREDENTIALS_PATH=serviceAccountKey.json

# Clave de la API de Google Gemini (Vertex AI / Google AI Studio)
# Cargar de forma segura (no escribir en el código fuente)
GEMINI_API_KEY=tu_api_key_aqui

# Seguridad y Criptografía
# Genera una clave aleatoria larga y segura para producción
JWT_SECRET_KEY=super-secret-key-roky-cyber-neon-2026-dynamic-token-9812

# Orígenes de CORS permitidos (Separados por comas para producción)
# Por defecto permite localhost para pruebas del simulador Flet
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000
